<!--
  USE ONLY ON AN AGENT-OWNED WEBSITE THAT STATE FARM HAS APPROVED.
  Your statefarm.com agent page is managed by State Farm; don't try to add this there.
  Fill the remaining {PLACEHOLDERS}, then validate at https://validator.schema.org
  Do NOT add aggregateRating from your own Google reviews (self-serving review markup is ignored
  by Google for local businesses and can trigger a manual action).
-->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "InsuranceAgency",
  "@id": "{SITE_URL}/#agency",
  "name": "Todd Butzine - State Farm Insurance Agent",
  "legalName": "Todd Butzine Insurance Agency, Inc.",
  "url": "{SITE_URL}/",
  "image": "{SITE_URL}/images/office-exterior.jpg",
  "description": "Local State Farm insurance agency in Gillette, Wyoming serving Campbell County with auto, home, renters, life, ATV/RV/boat, and small business insurance.",
  "telephone": "{PHONE}",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{ADDRESS}",
    "addressLocality": "Gillette",
    "addressRegion": "WY",
    "postalCode": "{ZIP}",
    "addressCountry": "US"
  },
  "geo": { "@type": "GeoCoordinates", "latitude": "{LAT}", "longitude": "{LNG}" },
  "areaServed": [
    { "@type": "City", "name": "Gillette, WY" },
    { "@type": "City", "name": "Wright, WY" },
    { "@type": "City", "name": "Moorcroft, WY" },
    { "@type": "City", "name": "Sundance, WY" },
    { "@type": "AdministrativeArea", "name": "Campbell County, WY" }
  ],
  "openingHoursSpecification": [
    { "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "{OPEN}", "closes": "{CLOSE}" }
  ],
  "brand": { "@type": "Brand", "name": "State Farm" },
  "sameAs": [
    "{AGENT_PAGE_URL}",
    "{GOOGLE_BUSINESS_PROFILE_URL}",
    "{FACEBOOK_URL}"
  ]
}
</script>
